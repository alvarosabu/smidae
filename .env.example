# Directus secrets — generate strong values for .env
KEY=replace-with-uuid
SECRET=replace-with-long-random-string

# Admin credentials (created by `pnpm directus:bootstrap`)
ADMIN_EMAIL=admin@smidae.dev
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=replace-with-random-token

# Database (SQLite file)
DB_CLIENT=sqlite3
DB_FILENAME=./directus/database/data.db

# Storage (local filesystem)
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./directus/uploads

# Public URL of the Directus instance
PUBLIC_URL=http://localhost:8055

# CORS — let Nuxt dev server hit it
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Nuxt-side runtime config
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
NUXT_DIRECTUS_TOKEN=replace-with-random-token
