{
  "name": "smidae",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "directus:bootstrap": "fnm exec --using=22.22.3 -- directus bootstrap",
    "directus:start": "PORT=8056 fnm exec --using=22.22.3 -- directus start",
    "directus:schema:bootstrap": "tsx scripts/directus-schema.ts",
    "directus:schema:snapshot": "fnm exec --using=22.22.3 -- directus schema snapshot --yes ./directus/snapshot.yaml",
    "directus:schema:apply": "fnm exec --using=22.22.3 -- directus schema apply --yes ./directus/snapshot.yaml",
    "seed": "tsx scripts/directus-seed.ts",
    "import": "tsx scripts/directus-import.ts",
    "directus:import:flow": "tsx scripts/directus-import-flow.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@directus/sdk": "22.0.0-rc.0",
    "@iconify-json/lucide": "^1.2.108",
    "@iconify-json/simple-icons": "^1.2.83",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.7.1",
    "@vueuse/nuxt": "14.3.0",
    "ai": "^6.0.197",
    "cheerio": "^1.2.0",
    "marked": "^18.0.4",
    "marked-shiki": "^1.2.1",
    "nuxt": "^4.4.6",
    "shiki": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "directus": "12.0.0-rc.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.0"
  },
  "packageManager": "pnpm@11.1.3"
}
